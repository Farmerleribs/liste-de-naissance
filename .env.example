# ============================================================================
#  Secrets de la fonction Edge `app`
#  À déclarer côté Supabase, PAS dans un fichier livré :
#     supabase secrets set --project-ref <ref> RESEND_API_KEY=... NOTIFY_EMAIL=...
#  SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement
#  par la plateforme : ne pas les définir à la main.
# ============================================================================

# Clé API Resend pour les notifications e-mail.
# Laisser vide désactive proprement les notifications (la fonction n'échoue pas).
RESEND_API_KEY=

# Destinataire des notifications (réservation, participation, livre d'or).
NOTIFY_EMAIL=

# Expéditeur. Avec le bac à sable Resend (onboarding@resend.dev), seul le
# propriétaire du compte Resend reçoit les messages. Pour envoyer à quelqu'un
# d'autre, il faut un domaine vérifié chez Resend.
NOTIFY_FROM=Liste de naissance <onboarding@resend.dev>
